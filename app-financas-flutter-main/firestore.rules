rules_version = '2';

// Regras de segurança do Firestore para o Guia Financeiro.
//
// Regra central: cada usuário só enxerga e altera os próprios dados.
// Publique com: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{userId} e tudo abaixo (incomes, bills)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Nega qualquer outro acesso não previsto acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
